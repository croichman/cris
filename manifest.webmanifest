{
  "name": "CRIS — Central de Registros e Informações de Saúde",
  "short_name": "CRIS",
  "description": "Central de Registros e Informações de Saúde da família: remédios, médicos, vacinas e doses.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F7F4",
  "theme_color": "#2F6F62",
  "icons": [
    {
      "src": "icons/icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icone-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "contato",
          "accept": [
            "text/vcard",
            "text/x-vcard",
            "text/directory",
            "text/plain",
            ".vcf",
            ".vcard"
          ]
        }
      ]
    }
  }
}
